{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merch visual DNA v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "revision",
    "workingTitle",
    "status",
    "songAssociations",
    "palette",
    "motifs",
    "composition",
    "invariants",
    "avoid",
    "provenance",
    "production"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "designId": {
      "type": "string",
      "pattern": "^design-[a-z0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "workingTitle": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["review", "approved", "retired"]
    },
    "songAssociations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^song-[a-z0-9-]+$"
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "hex"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "motifs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "composition": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "production": {
      "type": "object"
    }
  }
}
