{
	admin off
	auto_https off
}

http://{$EGOHYGIENE_HTTP_ADDRESS::80} {
	root * "{$EGOHYGIENE_PUBLIC_ROOT:/srv}"

	# The normal build emits directory/index.html for each canonical page.
	# Preserve the application’s no-trailing-slash URLs and query bytes.
	@intelligencePage path /intelligence/ /roadmap/ /decisions/ /dependencies/ /health/ /releases/ /distribution/ /sanity/ /hygiene/ /audits/ /status/ /intelligence/identity/ /intelligence/now/ /intelligence/journey/ /intelligence/work/ /search/ /intelligence/compare/ /intelligence/diagnostics/ /intelligence/dashboard/
	@indexAlias {
		path_regexp indexAlias ^/[^/]+(?:/[^/]+)*/index[.]html$
		file {path}
	}
	@slashAlias {
		path_regexp slashAlias ^/[^/]+(?:/[^/]+)*/$
		file {path}index.html
	}
	@domainFile {
		path /CNAME
		file {path}
	}
	@webManifest {
		path /site.webmanifest
		file {path}
	}
	@generatedPage file {path}/index.html
	@unsupportedMethod not method GET HEAD

	route {
		handle @unsupportedMethod {
			header Allow "GET, HEAD"
			respond "Method not allowed" 405
		}
		header @domainFile Content-Type "text/plain; charset=utf-8"
		header @webManifest Content-Type "application/manifest+json"
		respond /healthz "ok" 200

		# Preserve Intelligence canonical slash URLs and declared aliases.
		route /activity {
			rewrite * /intelligence/journey/
			redir {uri} 308
		}
		route /activity/ {
			rewrite * /intelligence/journey/
			redir {uri} 308
		}
		route /adr {
			rewrite * /decisions/
			redir {uri} 308
		}
		route /adr/ {
			rewrite * /decisions/
			redir {uri} 308
