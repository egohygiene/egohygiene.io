		}

		handle @intelligencePage {
			rewrite * {path}index.html
			file_server {
				disable_canonical_uris
			}
		}


		route /index.html {
			uri strip_suffix index.html
			redir {uri} 308
		}
		route @indexAlias {
			uri strip_suffix /index.html
			redir {uri} 308
		}
		route @slashAlias {
			uri strip_suffix /
			redir {uri} 308
		}

		error /404.html 404
		rewrite @generatedPage {file_match.relative}
		file_server {
			disable_canonical_uris
		}
	}

	handle_errors 404 {
		# Missing asset requests must never receive a successful SPA fallback.
		@assetDirectory path /assets /assets/* /fonts /fonts/* /icons /icons/*
		@assetFile {
			path_regexp assetFile [.]([^/]+)$
			not path *.html
		}
		handle @assetDirectory {
			respond "Not found" 404
		}
		handle @assetFile {
			respond "Not found" 404
		}
		handle {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}
