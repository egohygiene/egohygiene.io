# Optional Node-only diagnostic. Leave blank to use the local mock preview.
# Copy to .env.local only when you have a Fourthwall shop.
# Get a Storefront token (ptkn_) from Fourthwall Settings > For Developers.
# Never put a Platform API key, OAuth client secret, or payment credential here.
# These values intentionally have no VITE_ prefix and are not browser configuration.
FOURTHWALL_STOREFRONT_TOKEN=
# Optional HTTPS shop origin, e.g. https://your-shop.fourthwall.com
FOURTHWALL_SHOP_URL=
