{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    ".vitest/**/*.ts",
    ".vitest/**/*.tsx",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.tsx",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
