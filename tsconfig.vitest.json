{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "#test-utils": ["./.vitest/test-utils.tsx"],
      "@egohygiene/themes": ["./packages/themes/src/index.ts"]
    }
  },
  "include": [
    ".vitest/**/*.ts",
    ".vitest/**/*.tsx",
    "apps/*/src/**/*.d.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.tsx",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "tests/accessibility/**/*.ts",
    "tests/accessibility/**/*.tsx",
    "scripts/build-smoke.mts",
    "tests/smoke/**/*.ts",
    "tests/smoke/**/*.mts"
  ]
}
