{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "egohygiene-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Ego Hygiene website monorepo.",
  "homepage": "https://egohygiene.io",
  "bugs": {
    "url": "https://github.com/egohygiene/website/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/egohygiene/website.git"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@egohygiene/egohygiene.io --filter=@egohygiene/docs --filter=@egohygiene/playground",
    "build": "turbo run build",
    "check": "pnpm check:workspace && pnpm check:exports && pnpm check:circular && pnpm check:locales && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "pnpm test:unit && pnpm test:accessibility",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:accessibility": "vitest run --config vitest.accessibility.config.ts",
    "test:e2e": "playwright test",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "storybook": "storybook dev -p 6006 --config-dir .storybook --disable-telemetry",
    "storybook:build": "storybook build --config-dir .storybook --disable-telemetry",
    "clean": "rm -rf node_modules .turbo coverage playwright-report test-results storybook-static apps/*/dist packages/*/dist packages/*/node_modules/.cache dist-node",
    "check:workspace": "node --experimental-strip-types scripts/checks/check-workspace.ts",
    "check:exports": "node --experimental-strip-types scripts/checks/check-package-exports.ts",
    "check:circular": "node --experimental-strip-types scripts/checks/check-circular-dependencies.ts",
    "check:locales": "node --experimental-strip-types scripts/checks/check-locales.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "storybook": "10.5.5",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
