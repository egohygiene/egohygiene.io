{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/organization-intelligence-model-selection.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "visibility", "target", "as_of", "modules", "publications"],
  "properties": {
    "schema": {"const": "egohygiene.website.organization-intelligence-model-selection/v1"},
    "contract_version": {"const": "1.0.0-alpha.1"},
    "visibility": {"const": "public"},
    "target": {"const": {"origin": "https://egohygiene.github.io", "base_path": "/.github/"}},
    "as_of": {"$ref": "#/$defs/instant"},
    "modules": {
      "type": "object", "additionalProperties": false, "required": ["core", "audits", "sanity"],
      "properties": {"core": {"$ref": "#/$defs/optionalSelection"}, "audits": {"$ref": "#/$defs/optionalSelection"}, "sanity": {"$ref": "#/$defs/optionalSelection"}}
    },
    "publications": {"anyOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"$ref": "#/$defs/hash"}}
    }]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instant": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "optionalSelection": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/selection"}]},
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["visibility", "producer_repository", "producer_revision", "workflow_path", "run_id", "run_attempt", "artifact_id", "artifact_name", "archive_sha256", "manifest_sha256", "maximum_age_seconds"],
      "properties": {
        "visibility": {"const": "public"},
        "producer_repository": {"type": "string", "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"},
        "producer_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9._-]*\\.ya?ml$"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_attempt": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
        "archive_sha256": {"$ref": "#/$defs/hash"},
        "manifest_sha256": {"$ref": "#/$defs/hash"},
        "maximum_age_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}
      }
    }
  }
}
