{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/organization-intelligence-model-selection-receipt.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "contract_version", "visibility", "publication", "producer", "target", "evaluated_at", "export_manifest_sha256", "modules"],
  "properties": {
    "schema": {"const": "egohygiene.website.organization-intelligence-model-selection-receipt/v1"},
    "contract_version": {"const": "1.0.0-alpha.1"},
    "visibility": {"const": "public"},
    "publication": {"const": "review-only"},
    "producer": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision"],
      "properties": {"repository": {"const": "egohygiene/egohygiene.io"}, "revision": {"$ref": "#/$defs/revision"}}
    },
    "target": {"const": {"origin": "https://egohygiene.github.io", "base_path": "/.github/"}},
    "evaluated_at": {"$ref": "#/$defs/instant"},
    "export_manifest_sha256": {"$ref": "#/$defs/hash"},
    "modules": {
      "type": "object", "additionalProperties": false, "required": ["core", "audits", "sanity"],
      "properties": {"core": {"$ref": "#/$defs/module"}, "audits": {"$ref": "#/$defs/module"}, "sanity": {"$ref": "#/$defs/module"}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "instant": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "workflow_path", "run_id", "run_attempt"],
      "properties": {
        "repository": {"type": "string", "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"},
        "revision": {"$ref": "#/$defs/revision"},
        "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9._-]*\\.ya?ml$"},
        "run_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "run_attempt": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "code", "source_as_of", "source", "presentation_sha256", "presentation_state"],
      "properties": {
        "state": {"enum": ["available", "partial", "unavailable", "stale", "incompatible"]},
        "code": {"enum": ["NONE", "PARTIAL", "NOT_CONFIGURED", "INPUT_UNAVAILABLE", "INPUT_INCOMPATIBLE", "INPUT_STALE", "OWNER_INPUT_DENIED"]},
        "presentation_state": {"enum": ["available", "partial", "stale", "unavailable", "incompatible", "error"]},
        "source_as_of": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/instant"}]},
        "source": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/source"}]},
        "presentation_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
      },
      "allOf": [{
        "if": {"properties": {"state": {"enum": ["available", "partial"]}}},
        "then": {"properties": {"source": {"$ref": "#/$defs/source"}, "source_as_of": {"$ref": "#/$defs/instant"}, "presentation_sha256": {"$ref": "#/$defs/hash"}}},
        "else": {"properties": {"source": {"type": "null"}, "source_as_of": {"type": "null"}, "presentation_sha256": {"type": "null"}}}
      }]
    }
  }
}
