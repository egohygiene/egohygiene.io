{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "vitest*.ts",
    "playwright*.ts",
    "knip.config.ts",
    ".storybook/main.ts",
    "apps/*/vite.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "packages/*/scripts/**/*.ts"
  ]
}
